# Copy to .env in repository root before running Docker Compose.
# The backend reads these from its container environment. Never commit real keys.
# Provide at least ONE AI provider key. Optional providers can remain blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=

# Default backend HTTP/WebSocket port. Keep 7001 unless you update frontend URLs.
BACKEND_PORT=7001
